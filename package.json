{
	"name": "photosorter",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"typecheck": "vue-tsc --noEmit",
		"preview": "vite preview",
		"tauri": "tauri",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,tsx,vue,json}": [
			"biome check --write"
		]
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.1",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"tailwindcss": "^4.3.1",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@tauri-apps/cli": "^2",
		"@vitejs/plugin-vue": "^5.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.7",
		"typescript": "~5.6.2",
		"vite": "^6.0.3",
		"vue-tsc": "^2.1.10"
	}
}
